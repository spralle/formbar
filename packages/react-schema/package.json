{
	"name": "@formbar/react-schema",
	"version": "0.1.0",
	"type": "module",
	"description": "Schema-driven React form rendering — layout trees, renderers, and useSchemaForm hook",
	"license": "MIT",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run"
	},
	"dependencies": {
		"@formbar/core": "workspace:*",
		"@formbar/react": "workspace:*",
		"@formbar/from-schema": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"react": "^19.0.0"
	}
}
